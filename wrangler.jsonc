{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "threadbridge",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/events/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "BRIDGES", "class_name": "TicketBridge" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TicketBridge"] }],
  "vars": {
    "MODE": "mock",
    "SLACK_TEAM_ID": "T_DEMO",
    "SLACK_CHANNEL_ID": "C_SUPPORT",
    "JIRA_PROJECT": "OPS",
    "JIRA_ISSUE_TYPE": "Task",
    "JIRA_DONE_TRANSITION": "31",
    "JIRA_SERVICE_ACCOUNT_ID": "demo-service",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
